{
  "name": "irena-scenario-dialogue-tool",
  "version": "1.0.0",
  "description": "Interactive tool for IRENA workshops helping energy planners understand stakeholder perspectives on energy scenarios",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "verify:quotes": "node scripts/verify-toolkit-quotes.mjs src/data/case-studies.ts src/data/checklist.ts src/data/engagement-tools.ts src/data/stakeholder-profiles.ts src/types/toolkit.ts src/types/stakeholder.ts src/types/case-study.ts",
    "build:offline": "vite build --mode offline && node scripts/build-offline.mjs"
  },
  "keywords": [
    "energy",
    "planning",
    "stakeholder",
    "irena",
    "pwa",
    "offline"
  ],
  "author": "IRENA",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-pwa": "^1.2.0"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  }
}
